#!/bin/sh
set -eu

DATA_DIR=${KOTAUI_DATA_DIR:-/var/lib/kotaui}
PREFIX=${KOTAUI_PREFIX:-/opt/kotaui}
BIN_DIR=${KOTAUI_BIN_DIR:-/usr/local/bin}
GO_BIN=${KOTAUI_GO_BIN:-go}
RUNTIME_ENV="$DATA_DIR/runtime.env"
[ "$(id -u)" -eq 0 ] || { printf '%s\n' 'kota 必须以 root 身份运行。' >&2; exit 1; }
[ -r "$RUNTIME_ENV" ] || { printf '%s\n' '未发现 KotaUI 运行配置。' >&2; exit 1; }
set -a; . "$RUNTIME_ENV"; set +a
INTERACTIVE=0

clear_screen(){ command -v clear >/dev/null 2>&1 && clear || printf '\033c'; }
pause(){ [ "$INTERACTIVE" = 1 ] || return 0; printf '\n按 Enter 返回菜单…'; IFS= read -r _ || true; }
manager(){ if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then printf systemd; else printf openrc; fi; }
svc(){ if [ "$(manager)" = systemd ]; then systemctl "$2" "$1"; else rc-service "$1" "$2"; fi; }
running(){ if [ "$(manager)" = systemd ]; then systemctl is-active --quiet "$1"; else rc-service "$1" status >/dev/null 2>&1; fi; }
update_status(){ [ "${KOTAUI_PANEL_UPDATE:-}" = 1 ] || return 0; install -d -m 700 "$DATA_DIR"; update_run_id="${KOTAUI_UPDATE_RUN_ID:-}"; case "$update_run_id" in ''|*[!0-9]*) update_run_id="";; esac; temporary="$DATA_DIR/update.status.tmp.$$"; printf '{"runId":"%s","state":"%s","message":"%s","updatedAt":%s}\n' "$update_run_id" "$1" "$2" "$(date +%s)" > "$temporary" && mv -f "$temporary" "$DATA_DIR/update.status"; }
go_meets_requirement(){ output=$("$1" version 2>/dev/null || true); minor=$(printf '%s' "$output" | sed -n 's/.* go1\.\([0-9][0-9]*\)\..*/\1/p'); [ -n "$minor" ] && [ "$minor" -ge 22 ]; }
ensure_go_toolchain(){
  if command -v "$GO_BIN" >/dev/null 2>&1 && go_meets_requirement "$GO_BIN"; then return 0; fi
  if [ -x "$PREFIX/go/bin/go" ] && go_meets_requirement "$PREFIX/go/bin/go"; then GO_BIN="$PREFIX/go/bin/go"; return 0; fi
  case "$(uname -m)" in x86_64|amd64) arch=amd64; sha=4fa4f869b0f7fc6bb1eb2660e74657fbf04cdd290b5aef905585c86051b34d43;; aarch64|arm64) arch=arm64; sha=fd017e647ec28525e86ae8203236e0653242722a7436929b1f775744e26278e7;; *) return 1;; esac
  update_status running '系统 Go 版本不足，正在准备兼容工具链…'
  archive=$(mktemp) || return 1
  if ! curl -fsSL --retry 3 --connect-timeout 10 "https://go.dev/dl/go1.22.12.linux-${arch}.tar.gz" -o "$archive" || ! printf '%s  %s\n' "$sha" "$archive" | sha256sum -c - >/dev/null; then rm -f "$archive"; return 1; fi
  rm -rf "$PREFIX/go"
  if ! tar -C "$PREFIX" -xzf "$archive"; then rm -f "$archive"; return 1; fi
  rm -f "$archive"; GO_BIN="$PREFIX/go/bin/go"
  go_meets_requirement "$GO_BIN"
}

status(){
  clear_screen
  printf '%s\n' '================ KotaUI 状态 ================'
  printf '面板地址： https://%s:%s%s\n' "$KOTAUI_DOMAIN" "$KOTAUI_PANEL_PORT" "$KOTAUI_PANEL_PATH"
  printf '面板服务： '; running kotaui && printf '运行中\n' || printf '未运行\n'
  printf '核心服务： '; running kotaui-singbox && printf '运行中\n' || printf '未运行\n'
  printf '证书状态： '; openssl x509 -checkend 0 -noout -in "$KOTAUI_TLS_CERT" >/dev/null 2>&1 && printf '有效\n' || printf '无效或缺失\n'
  pause
}

service_menu(){
  clear_screen
  printf '%s\n' '1) 启动全部服务'
  printf '%s\n' '2) 停止全部服务'
  printf '%s\n' '3) 重启全部服务'
  printf '%s' '请选择： '; IFS= read -r choice || true
  case "$choice" in
    1) svc kotaui start; svc kotaui-singbox start;;
    2) svc kotaui-singbox stop || true; svc kotaui stop || true;;
    3) svc kotaui restart; svc kotaui-singbox restart;;
    *) return 0;;
  esac
  printf '服务操作已执行。\n'; pause
}

health(){
  result=0
  curl -kfsS --max-time 3 "https://127.0.0.1:${KOTAUI_PANEL_PORT}/health" >/dev/null 2>&1 || curl -fsS --max-time 3 "http://127.0.0.1:${KOTAUI_PANEL_PORT}/health" >/dev/null 2>&1 || result=1
  curl -ksS --max-time 3 -o /dev/null "https://127.0.0.1:${KOTAUI_SUBSCRIPTION_PORT:-1109}/__health_probe" || result=1
  "$KOTAUI_SINGBOX_BIN" check -c "$KOTAUI_SINGBOX_CONFIG" >/dev/null 2>&1 || result=1
  [ "$result" -eq 0 ] && printf '健康检查通过。\n' || printf '健康检查失败，请查看服务日志。\n' >&2
  pause
  return "$result"
}

logs(){
  clear_screen
  printf '%s\n' '1) KotaUI 面板日志'
  printf '%s\n' '2) sing-box 核心日志'
  printf '%s' '请选择： '; IFS= read -r pick || true
  unit=kotaui; [ "$pick" = 2 ] && unit=kotaui-singbox
  if [ "$(manager)" = systemd ]; then journalctl -u "$unit" -n 100 --no-pager; else tail -n 100 "/var/log/$unit.log" 2>/dev/null || true; fi
  pause
}

backup(){
  target="/root/kotaui-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$target" -C "$DATA_DIR" state.json runtime.env sing-box 2>/dev/null || tar -czf "$target" -C "$DATA_DIR" .
  printf '备份已保存：%s\n' "$target"; pause
}

renew(){ "$BIN_DIR/kota-cert-renew" && printf '续签检查完成。\n'; pause; }

update(){
  if [ "${1:-}" != "--yes" ]; then
    printf '将下载、编译并替换 KotaUI 程序，现有配置与证书不会变动。继续请输入 y [y/N]： '
    IFS= read -r answer || true
    case "$answer" in y|Y) ;; *) return 0;; esac
  fi
  update_status running '正在下载最新项目源码…'
  source=$(mktemp -d)
  if ! git clone --depth=1 https://github.com/ptfpwcpzy/KotaUI.git "$source"; then rm -rf "$source"; update_status failed '下载更新失败，请检查网络或更新日志。'; printf '下载更新失败。\n' >&2; return 1; fi
	if ! ensure_go_toolchain; then rm -rf "$source"; update_status failed 'Go 工具链不足或校验失败，请查看更新日志。'; printf 'Go 工具链不足或校验失败，更新已取消。\n' >&2; return 1; fi
  update_status running '正在构建兼容 sing-box 核心…'
	if ! KOTAUI_GO_BIN="$GO_BIN" sh "$source/service/kota-build-singbox-stats" "$source/sing-box-v2ray"; then rm -rf "$source"; update_status failed '兼容 sing-box 核心构建失败，请查看更新日志。'; printf '兼容 sing-box 核心构建失败，更新已取消。\n' >&2; return 1; fi
  update_status running '正在构建 KotaUI 面板程序…'
	if ! command -v "$GO_BIN" >/dev/null 2>&1 || ! (cd "$source" && CGO_ENABLED=0 "$GO_BIN" build -trimpath -ldflags='-s -w' -o "$source/kotaui" ./cmd/kotaui); then rm -rf "$source"; update_status failed '面板程序构建失败，请查看更新日志。'; printf '编译更新失败，更新已取消。\n' >&2; return 1; fi
  update_status running '正在原子替换程序与维护脚本…'
  install -m 755 "$source/kotaui" "$PREFIX/kotaui.new"
  install -m 755 "$source/sing-box-v2ray" "$PREFIX/sing-box-v2ray.new"
  mv -f "$PREFIX/kotaui.new" "$PREFIX/kotaui"
  mv -f "$PREFIX/sing-box-v2ray.new" "$PREFIX/sing-box-v2ray"
  install -d -m 755 /usr/local/lib/kotaui
  install -m 755 "$source/service/kotaui-update-run" /usr/local/lib/kotaui/kotaui-update-run
  install -m 755 "$source/service/kota" "$BIN_DIR/kota"
	install -m 755 "$source/service/kota-cert-renew" "$BIN_DIR/kota-cert-renew"
	install -m 755 "$source/service/kota-build-singbox-stats" "$PREFIX/bin/kota-build-singbox-stats"
	install -m 755 "$source/service/kotaui-wait-singbox-config" /usr/local/lib/kotaui/kotaui-wait-singbox-config
  sed -i "s|^KOTAUI_SINGBOX_BIN=.*|KOTAUI_SINGBOX_BIN=$PREFIX/sing-box-v2ray|" "$RUNTIME_ENV"
	if grep -q '^KOTAUI_GO_BIN=' "$RUNTIME_ENV"; then sed -i "s|^KOTAUI_GO_BIN=.*|KOTAUI_GO_BIN=$GO_BIN|" "$RUNTIME_ENV"; else printf 'KOTAUI_GO_BIN=%s\n' "$GO_BIN" >> "$RUNTIME_ENV"; fi
  update_status running '正在重启面板与 sing-box 核心…'
  if [ "$(manager)" = systemd ]; then
    install -m 644 "$source/service/kotaui.service" /etc/systemd/system/kotaui.service
    install -m 644 "$source/service/kotaui-singbox.service" /etc/systemd/system/kotaui-singbox.service
    install -m 644 "$source/service/kota-update.service" /etc/systemd/system/kota-update.service
    install -m 644 "$source/service/kota-cert-renew.service" /etc/systemd/system/kota-cert-renew.service
    install -m 644 "$source/service/kota-cert-renew.timer" /etc/systemd/system/kota-cert-renew.timer
    systemctl daemon-reload
    systemctl reset-failed kotaui-singbox >/dev/null 2>&1 || true
    systemctl restart kotaui kotaui-singbox
    systemctl enable --now kota-cert-renew.timer >/dev/null 2>&1 || true
  else
    install -m 755 "$source/service/kotaui.openrc" /etc/init.d/kotaui
    install -m 755 "$source/service/kotaui-singbox.openrc" /etc/init.d/kotaui-singbox
    install -d -m 755 /etc/conf.d
    printf 'KOTAUI_RUNTIME_ENV="%s/runtime.env"\n' "$DATA_DIR" > /etc/conf.d/kotaui
    install -m 755 "$source/service/kota-cert-renew" /etc/periodic/6hourly/kota-cert-renew
    rc-service kotaui restart || true; rc-service kotaui-singbox restart || true
  fi
  rm -rf "$source"
  update_status success '更新完成，面板与核心已恢复。'
  printf 'KotaUI 已更新，配置、用户数据和证书保持不变。\n'
  pause
}

remove_kotaui_certificate(){
  [ -n "${KOTAUI_DOMAIN:-}" ] || return 0
  certbot_bin=${KOTAUI_CERTBOT_BIN:-certbot}
  if [ -x "$certbot_bin" ] || command -v "$certbot_bin" >/dev/null 2>&1; then
    "$certbot_bin" delete --non-interactive --cert-name "$KOTAUI_DOMAIN" >/dev/null 2>&1 || true
  fi
  rm -rf "/etc/letsencrypt/live/$KOTAUI_DOMAIN" "/etc/letsencrypt/archive/$KOTAUI_DOMAIN" "/etc/letsencrypt/renewal/$KOTAUI_DOMAIN.conf"
}

uninstall(){
  clear_screen
  cat <<'EOF'
将停止服务并删除 KotaUI 面板、数据、sing-box 配置、定时任务和 KotaUI 专用证书。
不会删除系统 Python、Certbot、Go、sing-box 软件包或其他项目文件。
EOF
  printf '是否卸载 KotaUI？[y/N]: '
  IFS= read -r answer || true
  case "$answer" in y|Y) ;; *) printf '已取消卸载。\n'; return 0;; esac
  svc kotaui-singbox stop >/dev/null 2>&1 || true
  svc kotaui stop >/dev/null 2>&1 || true
  if [ "$(manager)" = systemd ]; then
    systemctl disable kotaui kotaui-singbox kota-cert-renew.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/kotaui.service /etc/systemd/system/kotaui-singbox.service /etc/systemd/system/kota-update.service /etc/systemd/system/kota-cert-renew.service /etc/systemd/system/kota-cert-renew.timer /usr/local/lib/kotaui/kotaui-update-run
    systemctl daemon-reload
  else
    rc-update del kotaui default >/dev/null 2>&1 || true
    rc-update del kotaui-singbox default >/dev/null 2>&1 || true
    rm -f /etc/init.d/kotaui /etc/init.d/kotaui-singbox /etc/conf.d/kotaui /etc/periodic/6hourly/kota-cert-renew
  fi
  remove_kotaui_certificate
  rm -rf "$PREFIX" "$DATA_DIR"
  rm -f "$BIN_DIR/kota" "$BIN_DIR/kota-cert-renew"
  printf 'KotaUI 已卸载完成。\n'
}

menu(){
  INTERACTIVE=1
  while :; do
    clear_screen
    cat <<'EOF'
============================================================
                    KotaUI 本机管理
============================================================
  1) 状态概览          2) 服务控制
  3) 查看日志          4) 健康检查
  5) 证书续签          6) 备份
  7) 更新 KotaUI       8) 卸载
  0) 退出
------------------------------------------------------------
EOF
    printf '请选择： '; IFS= read -r choice || true
    case "$choice" in
      1) status;; 2) service_menu;; 3) logs;; 4) health || true;;
      5) renew;; 6) backup;; 7) update;; 8) uninstall; exit 0;;
      0) exit 0;; *) printf '无效选择。\n'; sleep 1;;
    esac
  done
}

case "${1:-}" in
  status) status;;
  check) health;;
  restart) svc kotaui restart; svc kotaui-singbox restart;;
  update) update "${2:-}";;
  uninstall) uninstall;;
  *) menu;;
esac
