██    ██
██    ██
██    ██
 ██████ '
banner_i='████████
   ██   
   ██   
   ██   
   ██   
████████'
banner_art(){
  case "$1" in
    k) printf '%s\n' "$banner_k";;
    o) printf '%s\n' "$banner_o";;
    t) printf '%s\n' "$banner_t";;
    a) printf '%s\n' "$banner_a";;
    u) printf '%s\n' "$banner_u";;
    i) printf '%s\n' "$banner_i";;
  esac
}

print_banner(){
  cols=$(tput cols 2>/dev/null || echo 80)
  case "$cols" in ''|*[!0-9]*) cols=80;; esac
  if [ "$cols" -lt 60 ]; then
    ti=$(( (cols - 22) / 2 ))
    [ "$ti" -lt 0 ] && ti=0
    tpad=$(printf '%*s' "$ti" '')
    printf '%s%s轻量 sing-box 管理面板%s\n' "$tpad" "$C_DIM" "$C_RST"
    return 0
  fi
  indent=2
  if [ "$cols" -gt 63 ]; then indent=$(( (cols - 59) / 2 )); fi
  pad=$(printf '%*s' "$indent" '')
  row=1
  while [ "$row" -le 6 ]; do
    line="$pad"
    for L in k o t a u i; do
      ln=$(banner_art "$L" | sed -n "${row}p")
      case "$L" in
        k) c=$C_B1;; o) c=$C_B2;; t) c=$C_B3;;
        a) c=$C_B4;; u) c=$C_B5;; i) c=$C_B6;;
      esac
      line="${line}${c}${ln}${C_RST}  "
    done
    printf '%s\n' "$line"
    row=$((row + 1))
  done
  printf '%s%s          轻量 sing-box 管理面板%s\n' "$pad" "$C_DIM" "$C_RST"
}

# ---------- 基础工具 ----------
clear_screen(){ command -v clear >/dev/null 2>&1 && clear || printf '\033c'; }
pause(){ [ "$INTERACTIVE" = 1 ] || return 0; printf '\n  按 Enter 返回菜单…'; IFS= read -r _ || true; }
manager(){ if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then printf systemd; else printf openrc; fi; }
svc(){ if [ "$(manager)" = systemd ]; then systemctl "$2" "$1"; else rc-service "$1" "$2"; fi; }
running(){ if [ "$(manager)" = systemd ]; then systemctl is-active --quiet "$1"; else rc-service "$1" status >/dev/null 2>&1; fi; }
page_head(){
  printf '\n  %s%s%s\n' "$C_BOLD" "$1" "$C_RST"
  phcols=$(tput cols 2>/dev/null || echo 80)
  case "$phcols" in ''|*[!0-9]*) phcols=80;; esac
  if [ "$phcols" -lt 34 ]; then
    printf '  %s────────────────────────%s\n' "$C_DIM" "$C_RST"
  else
    printf '  %s────────────────────────────────%s\n' "$C_DIM" "$C_RST"
  fi
}
dot(){ if [ "$1" = 0 ]; then printf '%s●%s' "$C_GREEN" "$C_RST"; else printf '%s●%s' "$C_RED" "$C_RST"; fi; }

update_status(){ [ "${KOTAUI_PANEL_UPDATE:-}" = 1 ] || return 0; install -d -m 700 "$DATA_DIR"; update_run_id="${KOTAUI_UPDATE_RUN_ID:-}"; case "$update_run_id" in ''|*[!0-9]*) update_run_id="";; esac; temporary="$DATA_DIR/update.status.tmp.$$"; printf '{"runId":"%s","state":"%s","message":"%s","updatedAt":%s}\n' "$update_run_id" "$1" "$2" "$(date +%s)" > "$temporary" && mv -f "$temporary" "$DATA_DIR/update.status"; }
go_meets_requirement(){ output=$("$1" version 2>/dev/null || true); minor=$(printf '%s' "$output" | sed -n 's/.* go1\.\([0-9][0-9]*\)\..*/\1/p'); [ -n "$minor" ] && [ "$minor" -ge 26 ]; }
ensure_go_toolchain(){
  if command -v "$GO_BIN" >/dev/null 2>&1 && go_meets_requirement "$GO_BIN"; then return 0; fi
  if [ -x "$PREFIX/go/bin/go" ] && go_meets_requirement "$PREFIX/go/bin/go"; then GO_BIN="$PREFIX/go/bin/go"; return 0; fi
  case "$(uname -m)" in x86_64|amd64) arch=amd64; sha=9849f4e04ee35303714e34fbc3ac8ab44ea3e448a95aa182f91e3b9b79c710ec;; aarch64|arm64) arch=arm64; sha=6c2f29b458b5add0835f18b776f69c8881a6d88428f1484a6da55755e620757e;; *) return 1;; esac
  update_status running '系统 Go 版本不足，正在准备兼容工具链…'
  archive=$(mktemp) || return 1
  installed=0
  if curl -fsSL --retry 3 --connect-timeout 10 "https://go.dev/dl/go1.26.11.linux-${arch}.tar.gz" -o "$archive" && printf '%s  %s\n' "$sha" "$archive" | sha256sum -c - >/dev/null; then
    installed=1
  elif curl -fsSL --retry 3 --connect-timeout 10 "https://dl.google.com/go/go1.26.11.linux-${arch}.tar.gz" -o "$archive" && printf '%s  %s\n' "$sha" "$archive" | sha256sum -c - >/dev/null; then
    installed=1
  fi
  if [ "$installed" = 1 ]; then
    rm -rf "$PREFIX/go"
    if ! tar -C "$PREFIX" -xzf "$archive"; then rm -f "$archive"; return 1; fi
    rm -f "$archive"; GO_BIN="$PREFIX/go/bin/go"
    if go_meets_requirement "$GO_BIN"; then return 0; else return 1; fi
  fi
  rm -f "$archive"
  if ! command -v "$GO_BIN" >/dev/null 2>&1; then return 1; fi
  if ! GOTOOLCHAIN=go1.26.11 GOPROXY="${KOTAUI_GOPROXY:-https://goproxy.cn,direct}" "$GO_BIN" version >/dev/null 2>&1; then return 1; fi
  modcache=$(GOTOOLCHAIN=go1.26.11 GOPROXY="${KOTAUI_GOPROXY:-https://goproxy.cn,direct}" "$GO_BIN" env GOMODCACHE 2>/dev/null) || return 1
  GO_BIN="$modcache/golang.org/toolchain@v1.26.11/bin/go"
  [ -x "$GO_BIN" ] || return 1
  go_meets_requirement "$GO_BIN"
}

# ---------- 状态条 ----------
cert_ok(){ openssl x509 -checkend 0 -noout -in "$KOTAUI_TLS_CERT" >/dev/null 2>&1; }
cert_text(){
  if cert_ok; then
    end=$(openssl x509 -enddate -noout -in "$KOTAUI_TLS_CERT" 2>/dev/null | cut -d= -f2-)
    day=$(date -d "$end" +%F 2>/dev/null || true)
    if [ -n "$day" ]; then printf '有效期至 %s' "$day"; else printf '有效'; fi
  else
    printf '无效或缺失'
  fi
}

menu_status(){
  running kotaui && p_ok=1 || p_ok=0
  running kotaui-singbox && c_ok=1 || c_ok=0
  cert_ok && cert_ok_flag=1 || cert_ok_flag=0
  if [ "$p_ok" = 1 ]; then p_dot=$(dot 0); p_txt='运行中'; else p_dot=$(dot 1); p_txt='未运行'; fi
  if [ "$c_ok" = 1 ]; then c_dot=$(dot 0); c_txt='运行中'; else c_dot=$(dot 1); c_txt='未运行'; fi
  if [ "$cert_ok_flag" = 1 ]; then cert_dot=$(dot 0); else cert_dot=$(dot 1); fi
  mcols=$(tput cols 2>/dev/null || echo 80)
  case "$mcols" in ''|*[!0-9]*) mcols=80;; esac
  if [ "$mcols" -lt 74 ]; then
    printf '  %s %s面板服务%s %s\n' "$p_dot" "$C_DIM" "$C_RST" "$p_txt"
    printf '  %s %s核心服务%s %s\n' "$c_dot" "$C_DIM" "$C_RST" "$c_txt"
    printf '  %s %s证书%s %s\n' "$cert_dot" "$C_DIM" "$C_RST" "$(cert_text)"
    return 0
  fi
  printf '  %s %s面板服务%s %s    %s %s核心服务%s %s    %s %s证书%s %s\n' \
    "$p_dot" "$C_DIM" "$C_RST" "$p_txt" \
    "$c_dot" "$C_DIM" "$C_RST" "$c_txt" \
    "$cert_dot" "$C_DIM" "$C_RST" "$(cert_text)"
}

# ---------- 功能页 ----------
panel_login_info(){
  clear_screen
  page_head '面板登录信息'
  printf '  面板地址： https://%s:%s%s\n' "${KOTAUI_DOMAIN:-}" "${KOTAUI_PANEL_PORT:-}" "${KOTAUI_PANEL_PATH:-}"
  printf '  登录账号： %s\n' "${KOTAUI_ADMIN_USER:-}"
  printf '  登录密码： %s\n' "${KOTAUI_ADMIN_PASSWORD:-}"
  pause
}

change_admin_login(){
  clear_screen
  page_head '修改登录账号密码'
  printf '  当前账号： %s\n' "${KOTAUI_ADMIN_USER:-}"
  new_user=${KOTAUI_ADMIN_USER:-}
  while :; do
    printf '  新账号（回车不变）： '; IFS= read -r input || true
    [ -z "$input" ] && break
    case "$input" in *[!A-Za-z0-9_.@-]*) printf '  账号格式不对，3-20 位字母、数字及 _ . - @。\n'; continue;; esac
    [ "${#input}" -ge 3 ] && [ "${#input}" -le 20 ] || { printf '  账号格式不对，3-20 位字母、数字及 _ . - @。\n'; continue; }
    new_user=$input
    break
  done
  new_pass=${KOTAUI_ADMIN_PASSWORD:-}
  pw_changed=0
  while :; do
    printf '  新密码（回车不变）： '; IFS= read -r pw1 || true
    [ -z "${pw1:-}" ] && break
    printf '  再次输入新密码： '; IFS= read -r pw2 || true
    if [ "${pw1:-}" != "${pw2:-}" ]; then printf '  两次密码不一致。\n'; continue; fi
    case "$pw1" in *[!A-Za-z0-9_.@-]*) printf '  密码格式不对，6-20 位字母、数字及 _ . - @。\n'; continue;; esac
    [ "${#pw1}" -ge 6 ] && [ "${#pw1}" -le 20 ] || { printf '  密码格式不对，6-20 位字母、数字及 _ . - @。\n'; continue; }
    new_pass=$pw1
    pw_changed=1
    break
  done
  pw1=''; pw2=''
  if [ "$new_user" = "${KOTAUI_ADMIN_USER:-}" ] && [ "$pw_changed" = 0 ]; then
    printf '  未改动。\n'; pause; return 0
  fi
  printf '  新账号： %s\n' "$new_user"
  printf '  确认修改？[y/N]： '; IFS= read -r answer || true
  case "$answer" in y|Y) ;; *) printf '  已取消。\n'; pause; return 0;; esac
  cp -p "$RUNTIME_ENV" "$RUNTIME_ENV.bak" || { printf '  备份失败。\n' >&2; pause; return 0; }
  tmp_env="$RUNTIME_ENV.tmp.$$"
  if ! awk -v user="$new_user" -v pass="$new_pass" 'BEGIN{q="\047";u=0;p=0} /^KOTAUI_ADMIN_USER=/{ $0="KOTAUI_ADMIN_USER=" q user q; u=1 } /^KOTAUI_ADMIN_PASSWORD=/{ $0="KOTAUI_ADMIN_PASSWORD=" q pass q; p=1 } { print } END{ if(!u) print "KOTAUI_ADMIN_USER=" q user q; if(!p) print "KOTAUI_ADMIN_PASSWORD=" q pass q }' "$RUNTIME_ENV" > "$tmp_env"; then
    rm -f "$tmp_env"; printf '  写入失败。\n' >&2; pause; return 0
  fi
  chmod 600 "$tmp_env" && mv -f "$tmp_env" "$RUNTIME_ENV" || { rm -f "$tmp_env"; printf '  写入失败。\n' >&2; pause; return 0; }
  if svc kotaui restart; then
    sleep 2
    if running kotaui; then
      KOTAUI_ADMIN_USER=$new_user
      KOTAUI_ADMIN_PASSWORD=$new_pass
      printf '  已修改，请用新账号密码登录。\n'; pause; return 0
    fi
  fi
  printf '  重启失败，正在恢复。\n' >&2
  cp -p "$RUNTIME_ENV.bak" "$RUNTIME_ENV" || true
  svc kotaui restart >/dev/null 2>&1 || true
  printf '  修改失败，已恢复原账号密码。\n' >&2; pause; return 0
}

service_menu(){
  clear_screen
  page_head '服务控制'
  printf '  %s1%s  启动全部服务\n' "$C_CYAN" "$C_RST"
  printf '  %s2%s  停止全部服务\n' "$C_CYAN" "$C_RST"
  printf '  %s3%s  重启全部服务\n' "$C_CYAN" "$C_RST"
  printf '  %s0%s  返回\n' "$C_CYAN" "$C_RST"
  printf '\n  请选择 [0-3]： '; IFS= read -r choice || true
  case "$choice" in
    1) svc kotaui start; svc kotaui-singbox start;;
    2) svc kotaui-singbox stop || true; svc kotaui stop || true;;
    3) svc kotaui restart; svc kotaui-singbox restart;;
    *) return 0;;
  esac
  printf '  服务操作已执行。\n'; pause
}

health(){
  result=0
  curl -kfsS --max-time 3 "https://127.0.0.1:${KOTAUI_PANEL_PORT:-}/health" >/dev/null 2>&1 || curl -fsS --max-time 3 "http://127.0.0.1:${KOTAUI_PANEL_PORT:-}/health" >/dev/null 2>&1 || result=1
  curl -ksS --max-time 3 -o /dev/null "https://127.0.0.1:${KOTAUI_SUBSCRIPTION_PORT:-1109}/__health_probe" || result=1
  "${KOTAUI_SINGBOX_BIN:-}" check -c "${KOTAUI_SINGBOX_CONFIG:-}" >/dev/null 2>&1 || result=1
  [ "$result" -eq 0 ] && printf '健康检查通过。\n' || printf '健康检查失败，请查看服务日志。\n' >&2
  pause
  return "$result"
}

logs(){
  clear_screen
  page_head '查看日志'
  printf '  %s1%s  KotaUI 面板日志\n' "$C_CYAN" "$C_RST"
  printf '  %s2%s  sing-box 核心日志\n' "$C_CYAN" "$C_RST"
  printf '  %s0%s  返回\n' "$C_CYAN" "$C_RST"
  printf '\n  请选择 [0-2]： '; IFS= read -r pick || true
  unit=kotaui; [ "$pick" = 2 ] && unit=kotaui-singbox
  [ "$pick" = 1 ] || [ "$pick" = 2 ] || return 0
  if [ "$(manager)" = systemd ]; then journalctl -u "$unit" -n 100 --no-pager; else tail -n 100 "/var/log/$unit.log" 2>/dev/null || true; fi
  pause
}

renew(){
  if "$BIN_DIR/kota-cert-renew"; then
    printf '续签检查完成。\n'
  else
    printf '续签失败，请查看输出。\n' >&2
  fi
  pause
}

update(){
  if [ "${1:-}" != "--yes" ]; then
    printf '将下载、编译并替换 KotaUI 程序，现有配置与证书不会变动。继续请输入 y [y/N]： '
    IFS= read -r answer || true
    case "$answer" in y|Y) ;; *) return 0;; esac
  fi
  if command -v flock >/dev/null 2>&1 && { exec 9>"$DATA_DIR/update.lock"; } 2>/dev/null; then
    if ! flock -n 9 2>/dev/null; then
      printf '检测到已有更新任务在运行，本次取消。\n' >&2
      exec 9>&- 2>/dev/null || true
      return 1
    fi
    do_update
    rc=$?
    exec 9>&- 2>/dev/null || true
    return $rc
  fi
  do_update
}

# 更新失败时把旧二进制恢复回去并重启服务；各步失败也继续，调用方随后走失败路径。
restore_old_binaries(){
  if [ -f "$PREFIX/kotaui.old" ]; then mv -f "$PREFIX/kotaui.old" "$PREFIX/kotaui" || true; fi
  if [ -f "$PREFIX/sing-box-v2ray.old" ]; then mv -f "$PREFIX/sing-box-v2ray.old" "$PREFIX/sing-box-v2ray" || true; fi
  if [ "$(manager)" = systemd ]; then
    systemctl restart kotaui kotaui-singbox >/dev/null 2>&1 || true
  else
    rc-service kotaui restart >/dev/null 2>&1 || true
    rc-service kotaui-singbox restart >/dev/null 2>&1 || true
  fi
}

# do_update 异常退出（set -e 下任何一步失败）时的兜底：恢复旧二进制、清理
# 临时源码目录、写 failed 状态。正常完成或已走显式失败路径时不做任何事。
update_fail_cleanup(){
  [ "${update_in_progress:-0}" = 1 ] || return 0
  update_in_progress=0
  if [ "${update_replaced:-0}" = 1 ]; then restore_old_binaries || true; fi
  if [ -n "${source:-}" ] && [ -d "$source" ]; then rm -rf "$source" || true; fi
  update_status failed '更新失败，已恢复旧版本，请查看更新日志。' || true
}

do_update(){
  update_status running '正在下载最新项目源码…'
  prepare_go_cache
  source=$(mktemp -d /var/tmp/kotaui-build/src.XXXXXX)
  if ! git clone --depth=1 https://github.com/ptfpwcpzy/KotaUI.git "$source"; then rm -rf "$source"; update_status failed '下载更新失败，请检查网络或更新日志。'; printf '下载更新失败。\n' >&2; return 1; fi
  new_commit=$(git -C "$source" rev-parse HEAD 2>/dev/null || true)
  if ! ensure_go_toolchain; then rm -rf "$source"; update_status failed 'Go 工具链不足或校验失败，请查看更新日志。'; printf 'Go 工具链不足或校验失败，更新已取消。\n' >&2; return 1; fi
  # 核心指纹：版本号、补丁、构建脚本、构建标签、源码地址与 Go 版本都没变时，
  # 编出来的核心与已安装的相同，直接沿用，跳过几分钟的编译。指纹文件不存在
  # （本次改动后的第一次更新）或对不上时正常重编；用了预置核心或自定义补丁
  # 目录时不跳过。
  core_fingerprint_file="$PREFIX/sing-box-v2ray.fingerprint"
  core_fingerprint=$( {
    printf '%s\n' "VERSION=${KOTAUI_SINGBOX_VERSION:-}"
    printf '%s\n' "TAGS=${KOTAUI_SINGBOX_BUILD_TAGS:-}"
    printf '%s\n' "SOURCE=${KOTAUI_SINGBOX_SOURCE_URL:-}"
    "$GO_BIN" version 2>/dev/null || true
    sha256sum "$source/service/kota-build-singbox-stats" 2>/dev/null || true
    if ls "$source/service/patches/"*.patch >/dev/null 2>&1; then sha256sum "$source/service/patches/"*.patch; fi
  } | sha256sum | cut -d' ' -f1 )
  if [ -n "$core_fingerprint" ] && [ -z "${KOTAUI_SINGBOX_STATS_CORE:-}" ] && [ -z "${KOTAUI_SINGBOX_PATCH_DIR:-}" ] && [ -x "$PREFIX/sing-box-v2ray" ] && [ -f "$core_fingerprint_file" ] && [ "$(cat "$core_fingerprint_file" 2>/dev/null)" = "$core_fingerprint" ]; then
    update_status running '核心无变化，跳过重编…'
    if ! cp -p "$PREFIX/sing-box-v2ray" "$source/sing-box-v2ray"; then rm -rf "$source"; update_status failed '复用已安装核心失败，请查看更新日志。'; printf '复用已安装核心失败，更新已取消。\n' >&2; return 1; fi
  else
    update_status running '正在构建兼容 sing-box 核心…'
    if ! GOTOOLCHAIN=local KOTAUI_GO_BIN="$GO_BIN" sh "$source/service/kota-build-singbox-stats" "$source/sing-box-v2ray"; then rm -rf "$source"; update_status failed '兼容 sing-box 核心构建失败，请查看更新日志。'; printf '兼容 sing-box 核心构建失败，更新已取消。\n' >&2; return 1; fi
  fi
  update_status running '正在构建 KotaUI 面板程序…'
  if ! command -v "$GO_BIN" >/dev/null 2>&1 || ! (cd "$source" && CGO_ENABLED=0 GOTOOLCHAIN=local "$GO_BIN" build -trimpath -ldflags='-s -w' -o "$source/kotaui" ./cmd/kotaui); then rm -rf "$source"; update_status failed '面板程序构建失败，请查看更新日志。'; printf '编译更新失败，更新已取消。\n' >&2; return 1; fi
  update_status running '正在原子替换程序与维护脚本…'
  # 从替换开始，任何异常退出（set -e 下任何一步失败）都走兜底：恢复旧二进制、
  # 清理临时源码目录、报 failed，避免服务停机、状态卡在 running。
  update_in_progress=1
  update_replaced=0
  trap 'update_fail_cleanup' EXIT
  install -m 755 "$source/kotaui" "$PREFIX/kotaui.new"
  install -m 755 "$source/sing-box-v2ray" "$PREFIX/sing-box-v2ray.new"
  # 替换前备份旧二进制（旧文件不存在时不备份），重启失败时可恢复。
  if [ -f "$PREFIX/kotaui" ]; then cp -p -f "$PREFIX/kotaui" "$PREFIX/kotaui.old"; fi
  if [ -f "$PREFIX/sing-box-v2ray" ]; then cp -p -f "$PREFIX/sing-box-v2ray" "$PREFIX/sing-box-v2ray.old"; fi
  update_replaced=1
  mv -f "$PREFIX/kotaui.new" "$PREFIX/kotaui"
  mv -f "$PREFIX/sing-box-v2ray.new" "$PREFIX/sing-box-v2ray"
  install -d -m 755 /usr/local/lib/kotaui
  install -m 755 "$source/service/kotaui-update-run" /usr/local/lib/kotaui/kotaui-update-run
  install -m 755 "$source/service/kota" "$BIN_DIR/kota"
  install -m 755 "$source/service/kota-cert-renew" "$BIN_DIR/kota-cert-renew"
  install -m 755 "$source/service/kota-autoupdate" "$BIN_DIR/kota-autoupdate"
  install -m 755 "$source/service/kota-build-singbox-stats" "$PREFIX/bin/kota-build-singbox-stats"
  install -d -m 755 "$PREFIX/share/kotaui/patches"
  rm -f "$PREFIX/share/kotaui/patches/"*.patch
  install -m 644 "$source/service/patches/"*.patch "$PREFIX/share/kotaui/patches/"
  install -m 755 "$source/service/kotaui-wait-singbox-config" /usr/local/lib/kotaui/kotaui-wait-singbox-config
  sed -i "s|^KOTAUI_SINGBOX_BIN=.*|KOTAUI_SINGBOX_BIN=$PREFIX/sing-box-v2ray|" "$RUNTIME_ENV"
  if grep -q '^KOTAUI_GO_BIN=' "$RUNTIME_ENV"; then sed -i "s|^KOTAUI_GO_BIN=.*|KOTAUI_GO_BIN=$GO_BIN|" "$RUNTIME_ENV"; else printf 'KOTAUI_GO_BIN=%s\n' "$GO_BIN" >> "$RUNTIME_ENV"; fi
  update_status running '正在重启面板与 sing-box 核心…'
  restart_ok=1
  if [ "$(manager)" = systemd ]; then
    install -m 644 "$source/service/kotaui.service" /etc/systemd/system/kotaui.service
    install -m 644 "$source/service/kotaui-singbox.service" /etc/systemd/system/kotaui-singbox.service
    install -m 644 "$source/service/kota-update.service" /etc/systemd/system/kota-update.service
    install -m 644 "$source/service/kota-cert-renew.service" /etc/systemd/system/kota-cert-renew.service
    install -m 644 "$source/service/kota-cert-renew.timer" /etc/systemd/system/kota-cert-renew.timer
    systemctl daemon-reload
    systemctl reset-failed kotaui-singbox >/dev/null 2>&1 || true
    if ! systemctl restart kotaui kotaui-singbox; then restart_ok=0; fi
    systemctl enable --now kota-cert-renew.timer >/dev/null 2>&1 || true
  else
    install -m 755 "$source/service/kotaui.openrc" /etc/init.d/kotaui
    install -m 755 "$source/service/kotaui-singbox.openrc" /etc/init.d/kotaui-singbox
    install -d -m 755 /etc/conf.d
    printf 'KOTAUI_RUNTIME_ENV="%s/runtime.env"\n' "$DATA_DIR" > /etc/conf.d/kotaui
    # 证书续签与自动更新统一为每天一次的维护任务；删掉旧的 6 小时路径，避免新老并存。
    rm -f /etc/periodic/6hourly/kota-cert-renew
    install -m 755 "$source/service/kota-cert-renew" /etc/periodic/daily/kota-cert-renew
    install -m 755 "$source/service/kota-autoupdate" /etc/periodic/daily/kota-autoupdate
    if ! rc-service kotaui restart; then restart_ok=0; fi
    if ! rc-service kotaui-singbox restart; then restart_ok=0; fi
  fi
  if [ "$restart_ok" = 0 ]; then
    update_in_progress=0
    trap - EXIT
    restore_old_binaries
    rm -rf "$source"
    update_status failed '重启失败，已恢复旧版本，请查看服务日志。'
    printf '重启失败，已恢复旧版本。\n' >&2
    return 1
  fi
  # restart 返回 0 只说明进程拉起来了，新版本起来几秒后又崩也测不出来：
  # 像安装器一样循环健康检查（面板、订阅探针、配置校验 + 两个服务都在运行），
  # 超时按失败处理：恢复旧版本、不写 commit。
  update_status running '正在检查新版本是否正常运行…'
  health_ok=0
  attempt=0
  while [ "$attempt" -lt 15 ]; do
    if "$BIN_DIR/kota" check >/dev/null 2>&1 && running kotaui && running kotaui-singbox; then health_ok=1; break; fi
    attempt=$((attempt + 1))
    sleep 1
  done
  if [ "$health_ok" = 0 ]; then
    update_in_progress=0
    trap - EXIT
    restore_old_binaries
    rm -rf "$source"
    update_status failed '新版本健康检查失败，已恢复旧版本，请查看服务日志。'
    printf '新版本健康检查失败，已恢复旧版本。\n' >&2
    return 1
  fi
  # 重启成功，更新已生效：不再回滚旧二进制（trap 只保留到临时目录清理完）。
  update_replaced=0
  if [ -n "${new_commit:-}" ]; then printf '%s\n' "$new_commit" > "$DATA_DIR/installed.commit"; fi
  # 只有更新真正成功才写指纹：失败回滚后旧核心还在，旧指纹必须保持。
  # 写不上也不算失败，下次更新重编一次即可。
  printf '%s\n' "$core_fingerprint" > "$core_fingerprint_file" || true
  rm -rf "$source"
  update_in_progress=0
  trap - EXIT
  update_status success '更新完成，面板与核心已恢复。'
  printf 'KotaUI 已更新，配置、用户数据和证书保持不变。\n'
  pause
}

remove_kotaui_certificate(){
  [ -n "${KOTAUI_DOMAIN:-}" ] || return 0
  certbot_bin=${KOTAUI_CERTBOT_BIN:-certbot}
  if [ -x "$certbot_bin" ] || command -v "$certbot_bin" >/dev/null 2>&1; then
    "$certbot_bin" delete --non-interactive --cert-name "$KOTAUI_DOMAIN" >/dev/null 2>&1 || true
  fi
  rm -rf "/etc/letsencrypt/live/$KOTAUI_DOMAIN" "/etc/letsencrypt/archive/$KOTAUI_DOMAIN" "/etc/letsencrypt/renewal/$KOTAUI_DOMAIN.conf"
}

uninstall(){
  clear_screen
  cat <<'EOF'
将停止服务并删除 KotaUI 面板、数据、sing-box 配置、定时任务和 KotaUI 专用证书。
不会删除系统 Python、Certbot、Go、sing-box 软件包或其他项目文件。
EOF
  printf '是否卸载 KotaUI？[y/N]: '
  IFS= read -r answer || true
  case "$answer" in y|Y) ;; *) printf '已取消卸载。\n'; return 0;; esac
  svc kotaui-singbox stop >/dev/null 2>&1 || true
  svc kotaui stop >/dev/null 2>&1 || true
  if [ "$(manager)" = systemd ]; then
    systemctl disable kotaui kotaui-singbox kota-cert-renew.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/kotaui.service /etc/systemd/system/kotaui-singbox.service /etc/systemd/system/kota-update.service /etc/systemd/system/kota-cert-renew.service /etc/systemd/system/kota-cert-renew.timer /usr/local/lib/kotaui/kotaui-update-run
    systemctl daemon-reload
  else
    rc-update del kotaui default >/dev/null 2>&1 || true
    rc-update del kotaui-singbox default >/dev/null 2>&1 || true
    rm -f /etc/init.d/kotaui /etc/init.d/kotaui-singbox /etc/conf.d/kotaui /etc/periodic/6hourly/kota-cert-renew /etc/periodic/daily/kota-cert-renew /etc/periodic/daily/kota-autoupdate
  fi
  remove_kotaui_certificate
  rm -rf "$PREFIX" "$DATA_DIR"
  rm -f "$BIN_DIR/kota" "$BIN_DIR/kota-cert-renew" "$BIN_DIR/kota-autoupdate"
  printf 'KotaUI 已卸载完成。\n'
}

# ---------- 主菜单 ----------
menu(){
  INTERACTIVE=1
  while :; do
    clear_screen
    print_banner
    printf '\n'
    menu_status
    printf '\n'
    printf '  %s1%s  面板登录信息\n' "$C_CYAN" "$C_RST"
    printf '  %s2%s  服务控制\n' "$C_CYAN" "$C_RST"
    printf '  %s3%s  查看日志\n' "$C_CYAN" "$C_RST"
    printf '  %s4%s  证书续签\n' "$C_CYAN" "$C_RST"
    printf '  %s5%s  更新 KotaUI\n' "$C_CYAN" "$C_RST"
    printf '  %s6%s  卸载 KotaUI\n' "$C_CYAN" "$C_RST"
    printf '  %s7%s  修改登录账号密码\n' "$C_CYAN" "$C_RST"
    printf '  %s0%s  退出\n' "$C_CYAN" "$C_RST"
    printf '\n  请选择 [0-7]： '; IFS= read -r choice || true
    case "$choice" in
      1) panel_login_info;; 2) service_menu;; 3) logs;;
      4) renew;; 5) update;; 6) uninstall; exit 0;;
      7) change_admin_login;;
      0) exit 0;; *) printf '  无效选择。\n'; sleep 1;;
    esac
  done
}

case "${1:-}" in
  check) health;;            # 安装器内部：等待服务就绪
  update) update "${2:-}";; # 面板更新流程内部调用
  *) menu;;
esac
