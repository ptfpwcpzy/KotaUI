#!/bin/sh
set -eu

: "${KOTAUI_SINGBOX_BIN:?缺少 KOTAUI_SINGBOX_BIN}"
: "${KOTAUI_SINGBOX_CONFIG:?缺少 KOTAUI_SINGBOX_CONFIG}"

if [ ! -x "$KOTAUI_SINGBOX_BIN" ]; then
  printf 'sing-box 可执行文件不存在或不可执行：%s\n' "$KOTAUI_SINGBOX_BIN" >&2
  exit 127
fi
if [ ! -s "$KOTAUI_SINGBOX_CONFIG" ]; then
  printf 'sing-box 配置不存在或为空：%s\n' "$KOTAUI_SINGBOX_CONFIG" >&2
  exit 1
fi

exec "$KOTAUI_SINGBOX_BIN" run -c "$KOTAUI_SINGBOX_CONFIG"
