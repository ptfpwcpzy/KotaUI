#!/bin/sh
set -eu

prepare_go_cache() {
  install -d -m 700 /var/tmp/kotaui-build
  export TMPDIR=/var/tmp/kotaui-build
  export GOTMPDIR=/var/tmp/kotaui-build
  if [ -z "${HOME:-}" ] || [ "$HOME" = / ]; then export HOME=/root; fi
  # Alpine often mounts /var/tmp on tmpfs. A module cache there is discarded,
  # so every update downloads modules and recompiles. Reuse the persistent
  # cache under $HOME instead.
  unset GOPATH GOMODCACHE GOCACHE
  install -d -m 700 "$HOME/go/pkg/mod" "$HOME/.cache/go-build"
}

DESTINATION=${1:-/opt/kotaui/sing-box-v2ray}
VERSION=${KOTAUI_SINGBOX_VERSION:-v1.13.18}
SOURCE_URL=${KOTAUI_SINGBOX_SOURCE_URL:-https://github.com/SagerNet/sing-box.git}
# 集中维护运行协议与用户流量统计所需的 sing-box 编译能力；新增可选协议时只需在此补充对应标签。
BUILD_TAGS=${KOTAUI_SINGBOX_BUILD_TAGS:-with_v2ray_api,with_utls,with_quic}
GO_BIN=${KOTAUI_GO_BIN:-go}
prepare_go_cache
# sing-box 源码体积不小；Alpine 的 /var/tmp 常为 tmpfs，clone 到内存盘可能写满。
# 工作目录放到 $HOME 下的磁盘目录。
WORKDIR=$(mktemp -d "${HOME:-/root}/kotaui-build-work.XXXXXX")
trap 'rm -rf "$WORKDIR"' EXIT INT TERM

[ "$(id -u)" -eq 0 ] || { printf '%s\n' '构建兼容 sing-box 核心需要 root 权限。' >&2; exit 1; }
command -v git >/dev/null 2>&1 || { printf '%s\n' '未找到 git，无法构建兼容 sing-box 核心。' >&2; exit 1; }
command -v "$GO_BIN" >/dev/null 2>&1 || { printf '%s\n' '未找到 Go，无法构建兼容 sing-box 核心。' >&2; exit 1; }

install -d -m 755 "$(dirname "$DESTINATION")"
CANDIDATE="$WORKDIR/sing-box"
need_build=1
if [ -n "${KOTAUI_SINGBOX_STATS_CORE:-}" ]; then
  [ -x "$KOTAUI_SINGBOX_STATS_CORE" ] || { printf '%s\n' '指定的统计核心不可执行。' >&2; exit 1; }
  install -m 755 "$KOTAUI_SINGBOX_STATS_CORE" "$CANDIDATE"
  need_build=0
elif [ -n "${KOTAUI_SINGBOX_BIN:-}" ] && [ -x "$KOTAUI_SINGBOX_BIN" ]; then
  # 更新时线上核心版本未变则跳过重新编译（省掉几分钟）；版本变化、检测失败或指定了自定义核心时正常构建。
  installed_version=$("$KOTAUI_SINGBOX_BIN" version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)
  if [ -n "$installed_version" ] && [ "$installed_version" = "${VERSION#v}" ]; then
    printf '兼容 sing-box 核心已是 %s，跳过重新构建。\n' "$VERSION"
    install -m 755 "$KOTAUI_SINGBOX_BIN" "$CANDIDATE"
    need_build=0
  fi
fi
if [ "$need_build" -eq 1 ]; then
  printf '正在构建带用户流量统计的 sing-box 兼容核心（%s）…\n' "$VERSION"
  git clone --depth=1 --branch "$VERSION" "$SOURCE_URL" "$WORKDIR/source" >/dev/null 2>&1
	(cd "$WORKDIR/source" && GOMAXPROCS=1 CGO_ENABLED=0 "$GO_BIN" build -tags "$BUILD_TAGS" -trimpath -ldflags='-s -w' -o "$CANDIDATE" ./cmd/sing-box)
fi

CHECK_CONFIG="$WORKDIR/check.json"
cat > "$CHECK_CONFIG" <<'EOF'
{
  "experimental": {
    "v2ray_api": {
      "listen": "127.0.0.1:19090",
      "stats": {"enabled": true, "users": ["kotaui-check"]}
    }
  },
  "inbounds": [],
  "outbounds": [{"type":"direct","tag":"direct"}]
}
EOF
"$CANDIDATE" check -c "$CHECK_CONFIG" >/dev/null
TEMP_DESTINATION="$DESTINATION.new"
install -m 755 "$CANDIDATE" "$TEMP_DESTINATION"
mv -f "$TEMP_DESTINATION" "$DESTINATION"
printf '兼容 sing-box 核心已准备完成。\n'
