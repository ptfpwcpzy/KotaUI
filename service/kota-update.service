[Unit]
Description=KotaUI panel, core and script update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=GOPATH=/var/tmp/kotaui-build/gopath
Environment=GOMODCACHE=/var/tmp/kotaui-build/gomodcache
Environment=GOCACHE=/var/tmp/kotaui-build/gocache
EnvironmentFile=/var/lib/kotaui/runtime.env
ExecStart=/usr/local/lib/kotaui/kotaui-update-run
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
