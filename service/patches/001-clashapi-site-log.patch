diff --git a/experimental/clashapi/site_log.go b/experimental/clashapi/site_log.go
new file mode 100644
index 0000000..baa34c5
--- /dev/null
+++ b/experimental/clashapi/site_log.go
@@ -0,0 +1,98 @@
+package clashapi
+
+import (
+	"encoding/json"
+	"os"
+	"sync"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/clashapi/trafficontrol"
+	"github.com/sagernet/sing-box/log"
+)
+
+// siteLogRecord is one line of the connection close log tailed by the panel.
+// Start and End are Unix seconds; Duration is End minus Start. Host is empty
+// when the connection carried no domain (IP literal or unsniffed traffic).
+// Dst is the destination IP when known; the panel maps it to a service only
+// when Host is empty.
+type siteLogRecord struct {
+	User     string `json:"user"`
+	Host     string `json:"host"`
+	Dst      string `json:"dst"`
+	Upload   int64  `json:"upload"`
+	Download int64  `json:"download"`
+	Start    int64  `json:"start"`
+	End      int64  `json:"end"`
+}
+
+// siteLogWriter appends one JSON record per closed connection to a file. It
+// never blocks connection teardown: records go through a bounded channel and
+// are dropped when the channel is full, and write failures are logged once
+// and dropped. The file is opened with O_APPEND so an external reader may
+// safely truncate it once fully consumed.
+type siteLogWriter struct {
+	file  *os.File
+	queue chan []byte
+	once  sync.Once
+}
+
+func newSiteLogWriter(path string, logger log.Logger) (*siteLogWriter, error) {
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return nil, err
+	}
+	w := &siteLogWriter{file: file, queue: make(chan []byte, 8192)}
+	go w.run(logger)
+	return w, nil
+}
+
+func (w *siteLogWriter) handleClosed(metadata *trafficontrol.TrackerMetadata) {
+	if metadata == nil {
+		return
+	}
+	user := metadata.Metadata.User
+	if user == "" || metadata.OutboundType == C.TypeDNS {
+		return
+	}
+	upload := metadata.Upload.Load()
+	download := metadata.Download.Load()
+	if upload+download == 0 {
+		return
+	}
+	host := metadata.Metadata.Domain
+	if host == "" {
+		host = metadata.Metadata.Destination.Fqdn
+	}
+	dst := ""
+	if metadata.Metadata.Destination.Addr.IsValid() {
+		dst = metadata.Metadata.Destination.Addr.String()
+	}
+	record, err := json.Marshal(siteLogRecord{
+		User:     user,
+		Host:     host,
+		Dst:      dst,
+		Upload:   upload,
+		Download: download,
+		Start:    metadata.CreatedAt.Unix(),
+		End:      metadata.ClosedAt.Unix(),
+	})
+	if err != nil {
+		return
+	}
+	record = append(record, '\n')
+	select {
+	case w.queue <- record:
+	default:
+		// Channel full: drop the record rather than blocking teardown.
+	}
+}
+
+func (w *siteLogWriter) run(logger log.Logger) {
+	for record := range w.queue {
+		if _, err := w.file.Write(record); err != nil {
+			w.once.Do(func() {
+				logger.Warn("write site log: ", err)
+			})
+		}
+	}
+}
