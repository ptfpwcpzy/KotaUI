[Unit]
Description=KotaUI Go management panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/var/lib/kotaui/runtime.env
ExecStart=/opt/kotaui/kotaui
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/kotaui
MemoryMax=120M
TasksMax=64
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
