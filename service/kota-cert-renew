#!/bin/sh
set -eu

RUNTIME_ENV=${KOTAUI_RUNTIME_ENV:-/var/lib/kotaui/runtime.env}
[ -r "$RUNTIME_ENV" ] || exit 1
set -a
. "$RUNTIME_ENV"
set +a
CERTBOT_BIN=${KOTAUI_CERTBOT_BIN:-certbot}

if ! "$CERTBOT_BIN" renew --quiet; then
  exit 1
fi
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl try-restart kotaui kotaui-singbox
elif command -v rc-service >/dev/null 2>&1; then
  rc-service kotaui restart || true
  rc-service kotaui-singbox restart || true
fi
