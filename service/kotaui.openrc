#!/sbin/openrc-run
name="KotaUI"
command="/opt/kotaui/kotaui"
command_background="yes"
pidfile="/run/kotaui.pid"
command_user="root"
output_log="/var/log/kotaui.log"
error_log="/var/log/kotaui.log"

depend() {
  need net
  after firewall
}

start_pre() {
  export KOTAUI_DATA_DIR="${KOTAUI_RUNTIME_ENV:-/var/lib/kotaui}"
}
