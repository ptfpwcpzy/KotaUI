[Unit]
Description=KotaUI sing-box core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kotaui
ExecStartPre=/opt/kotaui/bin/kotaui-singbox-check
ExecStart=/opt/kotaui/bin/kotaui-singbox-run
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5
MemoryMax=256M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kotaui /opt/kotaui

[Install]
WantedBy=multi-user.target
