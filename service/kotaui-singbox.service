[Unit]
Description=KotaUI managed sing-box core
After=kotaui.service
Requires=kotaui.service

[Service]
Type=simple
EnvironmentFile=/var/lib/kotaui/runtime.env
ExecStartPre=/usr/local/lib/kotaui/kotaui-wait-singbox-config
ExecStart=/bin/sh -c 'test -x "$KOTAUI_SINGBOX_BIN" || { echo "sing-box 可执行文件不存在或不可执行：$KOTAUI_SINGBOX_BIN" >&2; exit 127; }; test -s "$KOTAUI_SINGBOX_CONFIG" || { echo "sing-box 配置不存在或为空：$KOTAUI_SINGBOX_CONFIG" >&2; exit 1; }; exec "$KOTAUI_SINGBOX_BIN" run -c "$KOTAUI_SINGBOX_CONFIG"'
ExecStartPost=/bin/sh -c 'date +%s > /run/kotaui-singbox.started'
ExecStopPost=/bin/rm -f /run/kotaui-singbox.started
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/kotaui
MemoryMax=180M
TasksMax=128
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
