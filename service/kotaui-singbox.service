[Unit]
Description=KotaUI managed sing-box core
After=kotaui.service
Requires=kotaui.service

[Service]
Type=simple
EnvironmentFile=/var/lib/kotaui/runtime.env
ExecStart=/usr/local/lib/kotaui/kotaui-singbox-run
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/kotaui
MemoryMax=180M
TasksMax=128
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
